# Camstar Modeling MCP Server - Environment Variables
# Copy this file to .env and fill in your values.

# Base URL of the Camstar Modeling API (no trailing slash)
CAMSTAR_BASE_URL=https://your-camstar-host/Modeling

# Base URL of the Camstar Shopfloor API. If omitted, it is derived from
# CAMSTAR_BASE_URL by replacing the trailing /Modeling with /Shopfloor.
CAMSTAR_SHOPFLOOR_BASE_URL=https://your-camstar-host/Shopfloor

# Base URL of the Camstar Query API. If omitted, it is derived from
# CAMSTAR_BASE_URL by replacing the trailing /Modeling with /Query.
CAMSTAR_QUERY_BASE_URL=https://your-camstar-host/Query

# API Authentication Credentials
CAMSTAR_USERNAME=your-username
CAMSTAR_PASSWORD=your-password

# HTTP request timeout in seconds (default: 30)
CAMSTAR_TIMEOUT=30

# Maximum response length (characters) before truncation kicks in (default: 4000)
MAX_RESPONSE_LENGTH=4000

# LLM 大模型配置（兼容 OpenAI 协议的任意模型）
# 支持: DeepSeek / Qwen (通义千问) / GLM (智谱) / Ollama 本地模型 等
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
#LLM_MODEL=deepseek-v4-flash

# Agent 单轮对话的最大连续思考/工具调用次数上限。防无限死循环。
# 超过此数值会导致：遇到过多连续的操作，自动中断了当前任务。
MAX_TOOL_LOOPS=30
# LangGraph node-step limit. One model/tool loop uses multiple graph steps.
# Defaults to MAX_TOOL_LOOPS * 6 + 10 when omitted.
LANGGRAPH_RECURSION_LIMIT=190

# Agent execution engine: langgraph (recommended) or legacy (rollback)
AGENT_ENGINE=langgraph
# Durable workflow checkpoint database
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite
# Reviewed self-improvement events and candidates
EXPERIENCE_DB=data/agent_experience.sqlite

# ---------------------------------------------------------------------------
# 外部 MCP 客户端（Streamable HTTP，独立于浏览器 /chat SSE）
# ---------------------------------------------------------------------------
# MCP 工具包含 MES 写操作，因此默认关闭。启用时必须设置高强度随机令牌。
ENABLE_MCP_HTTP=False
MCP_HTTP_PATH=/mcp
MCP_API_KEY=replace-with-a-long-random-secret
# 局域网开放时，把实际主机名或 IP 加入白名单，例如 172.25.23.19:*
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# 浏览器型 MCP 客户端需要配置允许的 Origin；普通桌面客户端可留空。
MCP_ALLOWED_ORIGINS=

ENABLE_PERFORMANCE_LOG=True

# ---------------------------------------------------------------------------
# 安全卡点阈值配置 (防误触保护)
# ---------------------------------------------------------------------------
# 批量创建超过多少条时要求先确认 (默认 20)
SAFE_CREATE_THRESHOLD=20
# 批量更新或修改超过多少条时要求先确认 (默认 3)
SAFE_UPDATE_THRESHOLD=3
# 批量删除超过多少条时要求先确认 (默认 0 表示 >= 1 即全量拦截)
SAFE_DELETE_THRESHOLD=0
