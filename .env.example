# Camstar Designer MCP 配置说明
# 格式：变量名=配置值；以 # 开头的行是注释，不参与配置。
# 每项的“示例”仅演示填写方式，请根据实际安装位置和账号修改配置行。
# 路径可使用 / 或反斜杠；含空格或 # 的值建议用单引号包裹；UNC 共享路径按示例直接填写。
# 相对路径以程序启动目录为基准；使用 start.ps1 启动时为项目根目录。
# 同名的系统或进程环境变量优先于 .env；修改配置值后需重启服务。
# 布尔值按各项说明填写；超时和数量填写整数，不要附加单位。
# 实际密钥和密码只填写在本机 .env，.env.example 保留空值或占位内容。
# 初次使用可复制 .env.example 为 .env；示例路径不保证与实际安装目录一致。
# 两份文件的配置项、顺序和说明保持一致；.env 填写实际值，.env.example 使用默认值或占位值。

# ---------- 本机 Designer 元数据文件 ----------
# 说明：本机元数据根目录，保存输入 MDB/XML、工作项目、设计产物和 MDB 备份。未设置时为 data/designer；输入文件必须位于此目录内。
# 示例：DESIGNER_ROOT=data/designer
DESIGNER_ROOT=data/designer

# 说明：本机官方 MetadataExport.exe 的绝对路径，用于命令行导出 MDB 差异。未安装或未验证该工具时留空；留空只禁用此命令行导出入口。
# 示例：DESIGNER_METADATA_EXPORT_EXE='C:\Program Files\Camstar\Tools\MetadataExport.exe'
DESIGNER_METADATA_EXPORT_EXE=

# 说明：本机已安装的 Camstar.Metadata.dll 绝对路径，用于通过官方对象模型查询、修改和编译 MDB。使用这些能力时必须填写，并保留同版本依赖组件。
# 示例：DESIGNER_METADATA_ASSEMBLY='C:\Program Files\Camstar\Designer2\Camstar.Metadata.dll'
DESIGNER_METADATA_ASSEMBLY=

# 说明：单次官方元数据桥调用的等待上限，单位为秒，填写正整数；未设置时为 180。大型设计处理较慢时可适当增大。
# 示例：DESIGNER_BRIDGE_TIMEOUT=180
DESIGNER_BRIDGE_TIMEOUT=180

# ---------- SQL Server 目标与发布 ----------
# 说明：目标 SQL Server 的服务器名称或 IP，用于数据库查询、发布预检与结果核验。连接数据库时必填；服务器共享也必须对应这台服务器。
# 示例：DESIGNER_DB_SERVER=192.0.2.10
DESIGNER_DB_SERVER=

# 说明：目标 Camstar/Opcenter 数据库名称，连接数据库时必填。请填写实际测试数据库名称。
# 示例：DESIGNER_DB_NAME=CamstarTest
DESIGNER_DB_NAME=

# 说明：SQL Server 登录账号，用于查询、核验及相关数据库管理操作。所需权限取决于功能；备份、恢复和 SQL Agent 作业需要对应权限。
# 示例：DESIGNER_DB_USER=designer_db_user
DESIGNER_DB_USER=

# 说明：上述 SQL Server 账号的密码，连接数据库时必填。以下为占位示例，实际密码只填写在本机 .env。
# 示例：DESIGNER_DB_PASSWORD='replace-with-your-sql-password'
DESIGNER_DB_PASSWORD=

# 说明：官方 Update DB 使用的 SQL 账号，其默认 schema 必须与应用 schema 一致。仅省略此配置项时沿用 DESIGNER_DB_USER；保留空值不会自动继承。
# 示例：DESIGNER_UPDATE_DB_USER=designer_update_user
DESIGNER_UPDATE_DB_USER=

# 说明：Update DB 专用 SQL 账号的密码。仅省略此配置项时沿用 DESIGNER_DB_PASSWORD；保留空值不会自动继承。
# 示例：DESIGNER_UPDATE_DB_PASSWORD='replace-with-your-update-password'
DESIGNER_UPDATE_DB_PASSWORD=

# 说明：是否已确认目标为允许操作的测试环境。未设置时为 false；只有 true（不区分大小写）表示已确认，发布、恢复及服务器生成等操作需要此确认。
# 示例：DESIGNER_TEST_TARGET_CONFIRMED=true
DESIGNER_TEST_TARGET_CONFIRMED=false

# 说明：发布前是否强制要求已校验的 SQL 数据库备份。默认 false，测试发布可跳过；只有 true（不区分大小写）开启。此项不影响工作 MDB 的备份保留。
# 示例：DESIGNER_REQUIRE_DATABASE_BACKUP=false
DESIGNER_REQUIRE_DATABASE_BACKUP=false

# ---------- 服务器 Designer、共享与 WCF ----------
# 说明：服务器上已部署的 WCF 服务目录，程序从该目录读取 Web.config 和服务配置；服务器 WCF 生成时必填。当前实现要求服务器 C 盘上的绝对目录路径。
# 示例：DESIGNER_WCF_DIRECTORY='C:\Camstar\WCFServices'
DESIGNER_WCF_DIRECTORY=

# 说明：服务器 C 盘共享地址，用于交接、同步 MDB 及 WCF 文件传输。当前实现必须为 \\DESIGNER_DB_SERVER\C，不能替换为 C$ 或其他共享名。
# 示例：DESIGNER_SERVER_SHARE=\\192.0.2.10\C
DESIGNER_SERVER_SHARE=

# 说明：服务器上的 Designer 界面程序绝对路径，用于读取安装配置、准备工作文件及设置下次启动的 MDB。当前实现要求服务器 C 盘上的 exe 路径。
# 示例：DESIGNER_UI_EXE='C:\Program Files\Camstar\Designer2\Designer.Net.UI.exe'
DESIGNER_UI_EXE=

# 说明：服务器官方 ImportMetaData.exe 的绝对路径，用于安装入口检查。当前实现要求 C 盘上的 exe 路径；配置此项不表示自动导入能力已经验收。
# 示例：DESIGNER_SERVER_IMPORT_EXE='C:\Program Files\Camstar\InSite Administration\Designer\ImportMetaData.exe'
DESIGNER_SERVER_IMPORT_EXE=

# 说明：访问服务器共享的 Windows 账号，可填写域账号或服务器本地账号。需要相应文件读写权限；SQL 账号另外填写在 DESIGNER_DB_USER 中。
# 示例：DESIGNER_WINDOWS_USER='CONTOSO\designer_user'
DESIGNER_WINDOWS_USER=

# 说明：上述 Windows 账号的密码，用于认证服务器共享。仅在需要服务器文件交接、同步或 WCF 生成时填写真实凭据。
# 示例：DESIGNER_WINDOWS_PASSWORD='replace-with-your-windows-password'
DESIGNER_WINDOWS_PASSWORD=

# 说明：服务器 WCF 生成使用的 SiteInfo.mdb 绝对路径，生成时必须填写服务器 C 盘上的现有文件路径。Designer 文件交接另从其安装配置读取站点文件。
# 示例：DESIGNER_SERVER_SITEINFO='C:\Camstar\Database\SiteInfo.mdb'
DESIGNER_SERVER_SITEINFO=

# 说明：服务器 WCF 生成器的组件目录，内含 Camstar.WCFGenerator.dll、配套 DLL 和 app.config。填写 C 盘上的绝对目录路径，不要填写 exe 或 DLL 文件路径。
# 示例：DESIGNER_SERVER_WCF_GENERATOR='C:\Program Files\Camstar\WCFGenerator'
DESIGNER_SERVER_WCF_GENERATOR=

# 说明：传给官方 WCF 生成器的服务地址，用于生成客户端及服务配置。服务器 WCF 生成时必填，请与实际部署的服务地址保持一致。
# 示例：DESIGNER_WCF_ADDRESS=http://192.0.2.10/CamstarWCFServices/
DESIGNER_WCF_ADDRESS=

# ---------- 超时设置 ----------
# 说明：服务器 WCF 生成工作进程的等待上限，单位为秒；未设置时为 1800。允许范围为 10～3600 的整数，超出范围会导致配置加载失败。
# 示例：DESIGNER_SERVICE_TIMEOUT=1800
DESIGNER_SERVICE_TIMEOUT=1800

# 说明：官方 Update DB 发布进程的等待上限，单位为秒，填写正整数；未设置时为 900。
# 示例：DESIGNER_PUBLICATION_TIMEOUT=900
DESIGNER_PUBLICATION_TIMEOUT=900

# 说明：MetadataExport.exe 导出差异的等待上限，单位为秒，填写正整数；未设置时为 120，仅用于该命令行导出入口。
# 示例：DESIGNER_EXPORT_TIMEOUT=120
DESIGNER_EXPORT_TIMEOUT=120

# ---------- 浏览器工作台 ----------
# 说明：浏览器工作台监听的端口号，填写 1～65535 的整数；未设置时为 8032，对应访问地址 http://localhost:8032。
# 示例：SERVER_PORT=8032
SERVER_PORT=8032

# 说明：单用户工作台的会话归属名称，未设置时为 designer；建议使用字母、数字、下划线或短横线。更换名称会切换对应历史记录，不是 SQL 或 Windows 登录账号。
# 示例：CHAT_USERNAME=designer
CHAT_USERNAME=designer

# ---------- 自然语言聊天的模型接口 ----------
# 说明：模型服务的 API 密钥，自然语言聊天时必填；由 LLM_BASE_URL 所对应的平台提供。your-api-key 是占位符，需要替换为自己的真实密钥。
# 示例：LLM_API_KEY=your-api-key
LLM_API_KEY=your-api-key

# 说明：兼容 OpenAI 协议的模型接口基础地址，不要填写具体 chat/completions 请求地址。未设置时为 https://api.deepseek.com/v1；其他平台填写其兼容接口地址。
# 示例：LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 说明：模型服务支持的实际模型标识，必须与 LLM_BASE_URL 和 API 密钥对应；未设置时为 deepseek-chat。
# 示例：LLM_MODEL=deepseek-chat
LLM_MODEL=deepseek-chat

# ---------- 对话执行次数 ----------
# 说明：一次对话中模型连续推理、调用工具的循环上限，填写正整数；未设置时为 15，本示例使用 30。达到上限后停止继续执行。
# 示例：MAX_TOOL_LOOPS=30
MAX_TOOL_LOOPS=30

# 说明：一次对话允许的流程节点步数，包含模型、策略和工具节点，需要高于工具循环上限。未设置时为 MAX_TOOL_LOOPS×6+10，实际最小值为 25；循环上限 30 时可填 190。
# 示例：LANGGRAPH_RECURSION_LIMIT=190
LANGGRAPH_RECURSION_LIMIT=190

# ---------- 本地记录存储 ----------
# 说明：设计进度、人工确认及后台操作回执的 SQLite 文件路径；未设置时为 data/designer_progress.sqlite。
# 示例：DESIGNER_PROGRESS_DB=data/designer_progress.sqlite
DESIGNER_PROGRESS_DB=data/designer_progress.sqlite

# 说明：LangGraph 对话执行状态与检查点的 SQLite 文件路径，用于保存和恢复对话流程；未设置时为 data/langgraph_checkpoints.sqlite。
# 示例：LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite
LANGGRAPH_CHECKPOINT_DB=data/langgraph_checkpoints.sqlite

# 说明：对话经验记录、候选改进及相关状态的 SQLite 文件路径；未设置时为 data/agent_experience.sqlite。
# 示例：EXPERIENCE_DB=data/agent_experience.sqlite
EXPERIENCE_DB=data/agent_experience.sqlite

# ---------- 外部 MCP 接入 ----------
# 说明：是否启用供外部 MCP 客户端访问的 HTTP 接口，默认关闭。true、1、yes（不区分大小写）表示启用；启用时必须同时填写非空 MCP_API_KEY。
# 示例：ENABLE_MCP_HTTP=False
ENABLE_MCP_HTTP=False

# 说明：外部 MCP 接口挂载路径，未设置或留空时为 /mcp；启用后客户端连接 http://localhost:8032/mcp/。程序会补齐开头斜杠并去除末尾斜杠。
# 示例：MCP_HTTP_PATH=/mcp
MCP_HTTP_PATH=/mcp

# 说明：外部 MCP 接口的 Bearer 访问令牌，客户端通过 Authorization: Bearer <令牌> 传入。启用 MCP 时必填，示例占位符应替换为足够长的随机密钥。
# 示例：MCP_API_KEY=replace-with-a-long-random-secret
MCP_API_KEY=replace-with-a-long-random-secret

# 说明：MCP 接口允许的 Host 列表，用逗号分隔；:* 表示任意端口。未设置时允许本机三个地址；从局域网访问时需另外加入实际服务器名称或 IP。
# 示例：MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,192.0.2.10:8032
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*

# 说明：MCP 请求允许的 Origin 列表，用逗号分隔，填写协议、主机和端口。留空使用 FastMCP 默认来源规则；客户端发送 Origin 时需按需加入对应来源，与聊天页面配置独立。
# 示例：MCP_ALLOWED_ORIGINS=http://localhost:8032,http://192.0.2.10:8032
MCP_ALLOWED_ORIGINS=

# ---------- 运行日志 ----------
# 说明：是否记录性能日志并在运行日志页面提供数据；未设置时启用。true、1、yes（不区分大小写）表示启用，false 表示关闭。
# 示例：ENABLE_PERFORMANCE_LOG=True
ENABLE_PERFORMANCE_LOG=True

# ---------- 设计定义写操作的确认阈值 ----------
# 说明：一次对话累计创建的设计定义数量超过该阈值时，要求用户确认；填写非负整数，未设置时为 20。填写 20 时第 21 项触发，本地草案生成不计入定义写入。
# 示例：SAFE_CREATE_THRESHOLD=20
SAFE_CREATE_THRESHOLD=20

# 说明：一次对话累计更新的设计定义数量超过该阈值时，要求用户确认；填写非负整数，未设置时为 3。填写 3 时第 4 项触发。
# 示例：SAFE_UPDATE_THRESHOLD=3
SAFE_UPDATE_THRESHOLD=3

# 说明：一次对话累计删除的设计定义数量超过该阈值时，要求用户确认；填写非负整数，未设置时为 0。填写 0 表示从第 1 项删除开始就需要确认。
# 示例：SAFE_DELETE_THRESHOLD=0
SAFE_DELETE_THRESHOLD=0
